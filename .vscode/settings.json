{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.analysis.extraPaths": ["courseforge/src"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/video/out": true
  }
}
